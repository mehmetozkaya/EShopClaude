@page "/"
@rendermode InteractiveServer
@using System.Globalization
@inject CatalogApiClient Catalog
@inject BasketApiClient Basket

<PageTitle>Products</PageTitle>

<h1>Products</h1>

@if (added != null)
{
    <p class="alert alert-success">Added @added</p>
}

@if (products == null)
{
    <p><em>Loading…</em></p>
}
else if (products.Length == 0)
{
    <p>No products.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in products)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Description</td>
                    <td>@p.Price.ToString("0.00", CultureInfo.InvariantCulture)</td>
                    <td><button class="btn btn-primary btn-sm" @onclick="() => AddAsync(p)">Add to cart</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private ProductDto[]? products;
    private string? added;

    protected override async Task OnInitializedAsync()
        => products = await Catalog.GetProductsAsync();

    private async Task AddAsync(ProductDto p)
    {
        await Basket.AddItemAsync(Buyer.Id, p.Id, 1);
        added = p.Name;
    }
}
