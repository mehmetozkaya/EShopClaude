@page "/cart"
@rendermode InteractiveServer
@using System.Globalization
@inject BasketApiClient Basket
@inject NavigationManager Nav

<PageTitle>Cart</PageTitle>

<h1>Cart</h1>

@if (basket == null)
{
    <p><em>Loading…</em></p>
}
else if (basket.Items.Count == 0)
{
    <p>Your cart is empty. <a href="">Browse products</a>.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Unit price</th>
                <th>Qty</th>
                <th>Line total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in basket.Items)
            {
                <tr>
                    <td>@i.ProductName</td>
                    <td>@Money(i.UnitPrice)</td>
                    <td>@i.Quantity</td>
                    <td>@Money(i.UnitPrice * i.Quantity)</td>
                    <td><button class="btn btn-danger btn-sm" disabled="@placing" @onclick="() => RemoveAsync(i)">Remove</button></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">Total</th>
                <th>@Money(basket.Items.Sum(i => i.UnitPrice * i.Quantity))</th>
                <th></th>
            </tr>
        </tfoot>
    </table>
    <button class="btn btn-primary" disabled="@placing" @onclick="PlaceOrderAsync">Place order</button>
}

@code {
    private BasketDto? basket;
    private bool placing;

    protected override async Task OnInitializedAsync()
        => basket = await Basket.GetBasketAsync(Buyer.Id);

    private async Task RemoveAsync(BasketItemDto i)
        => basket = await Basket.RemoveItemAsync(Buyer.Id, i.ProductId);

    private async Task PlaceOrderAsync()
    {
        if (placing) return;
        placing = true;
        var orderId = await Basket.CheckoutAsync(Buyer.Id);
        Nav.NavigateTo($"/orders/{orderId}");
    }

    private static string Money(decimal amount) => amount.ToString("0.00", CultureInfo.InvariantCulture);
}
